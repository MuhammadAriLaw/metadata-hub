// Pastikan file .api_key berada di folder yang sama dan berisi: $api_key = 'API_KEY_ANDA';
if (file_exists('.api_key')) {
    require '.api_key';
}

$service_url = 'https://kgsearch.googleapis.com/v1/entities:search';
$params = array(
  'query' => 'Muhammad Ari Pratomo MuhammadAriLaw',
  'limit' => 1,
  'indent' => TRUE,
  'key' => isset($api_key) ? $api_key : ''
);

$url = $service_url . '?' . http_build_query($params);
$ch = curl_init();
curl_setopt($ch, CURLOPT_URL, $url);
curl_setopt($ch, CURLOPT_RETURNTRANSFER, 1);
curl_setopt($ch, CURLOPT_TIMEOUT, 10);

$output = curl_exec($ch);
$http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
curl_close($ch);

if ($http_code === 200 && $output) {
    $response = json_decode($output, true);
    
    if (isset($response['itemListElement']) && is_array($response['itemListElement'])) {
        foreach($response['itemListElement'] as $element) {
            if (isset($element['result']['name'])) {
                echo $element['result']['name'] . '<br/>';
            }
        }
    }
}
